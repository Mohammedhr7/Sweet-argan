    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "latest",
